# AutoLab environment template — copy to .env and fill in.

# Required for any agent that calls Claude.
ANTHROPIC_API_KEY=

# Persistent state. SQLite is fine for local dev; Postgres is the target for production.
# Examples:
#   DATABASE_URL=sqlite+aiosqlite:///./autolab.db
#   DATABASE_URL=postgresql+psycopg://autolab:autolab@localhost:5432/autolab
DATABASE_URL=sqlite+aiosqlite:///./autolab.db

# LangGraph checkpointer + agent comms.
REDIS_URL=redis://localhost:6379/0

# Structured logging level.
LOG_LEVEL=INFO

# Set to 1 to opt into tests that hit real external services (Anthropic, arxiv, ...).
RUN_LIVE_TESTS=0
